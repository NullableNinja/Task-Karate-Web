---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';
import GeometricPattern from '@/components/GeometricPattern.astro';
import { assistantInstructors } from '@/data/team';
---
<BaseLayout title="About Task Karate | La Crosse, Wisconsin" description="Learn about Task Karate School, its neighborhood dojo culture, philosophy, and head instructor Randy Thomson in La Crosse, Wisconsin.">
  <section class="page-hero"><GeometricPattern class="geo-pattern--page" /><div class="shell page-hero-grid"><div><p class="eyebrow eyebrow--cyan">About Task Karate</p><h1>Built by people<br /><em>who train here.</em></h1></div><p>A friendly, focused school with serious practice and room for beginners, families, and experienced martial artists.</p></div></section>
  <section class="section section--light"><div class="shell about-profile"><img src={withBase('/images/randy-thomson.png')} width="194" height="298" loading="lazy" alt="Randy Thomson in a blue Task Karate uniform" /><div><p class="eyebrow eyebrow--teal">Owner & head instructor</p><h2>Randy “Mr. T” Thomson</h2><p class="large-copy">Randy has spent more than 30 years in martial arts and more than 20 years teaching. He is a U.S. Army veteran and a fourth-degree black belt.</p><p>His primary style is American Karate based on Tae Kwon Do, with training in Judo, Aikido, Filipino Eskrima, Japanese Karate-Do, wrestling, boxing, Okinawan Kobudo, and Kenpo.</p><p>Outside the dojo, Randy enjoys canoeing, fishing, guitar, and hiking—and being a dad to Trevin and Mason.</p></div></div></section>
  <section class="section helpers-section"><div class="shell helpers-grid"><div><p class="eyebrow eyebrow--gold">The teaching team</p><h2>Built by one teacher.<br /><em>Strengthened by many.</em></h2><p class="helper-note">Assistant instructors are part of the everyday teaching team at Task Karate. They help students learn, practice safely, and feel at home in the dojo.</p></div><div><p class="large-copy">These are the people who help make training possible alongside Randy “Mr. T” Thomson.</p><ul class="assistant-instructor-list">{assistantInstructors.map((name, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{name}</strong><small>Assistant Instructor</small></li>)}</ul><p class="helper-note">Individual bios and new team photography will be added as they are approved.</p></div></div></section>
  <section class="section section--navy about-student-section"><div class="shell visit-grid"><div><p class="eyebrow eyebrow--cyan">For current students</p><h2>Looking for<br /><em>dojo resources?</em></h2></div><div><p class="large-copy">Rules, handbook guidance, testing requirements, and Student Portal access live together on the Students page.</p><a class="arrow-link arrow-link--light" href={withBase('/students/')}>Visit the Students page <span aria-hidden="true">→</span></a></div></div></section>
  <section class="section section--light visit-section"><div class="shell visit-grid"><div><p class="eyebrow eyebrow--purple">Your first visit</p><h2>Curious is<br /><em>enough to begin.</em></h2></div><div><p class="large-copy">You do not need to know everything before you start. Bring your questions, tell the school which program interests you, and ask about the right first class.</p><a class="arrow-link" href={withBase('/contact/')}>Start the conversation <span aria-hidden="true">→</span></a></div></div></section>
</BaseLayout>
