---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GeometricPattern from '@/components/GeometricPattern.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import CtaSection from '@/components/CtaSection.astro';
import LocationMap from '@/components/LocationMap.astro';
import { programs } from '@/data/programs';
import { withBase } from '@/lib/paths';
---
<BaseLayout title="Task Karate School | La Crosse martial arts for kids, teens & adults" description="Task Karate School is a welcoming neighborhood martial arts school in La Crosse, Wisconsin, offering karate, Eskrima, and focused training for kids, teens, and adults.">
  <section class="hero-home"><GeometricPattern class="geo-pattern--hero" /><div class="shell hero-home-stack"><div class="v3-tape v3-tape--hero" aria-hidden="true"></div><div class="v3-frame-back" aria-hidden="true"></div><div class="hero-home-grid v3-panel"><div class="hero-home-copy"><p class="eyebrow eyebrow--cyan">La Crosse • Friendly • Practical</p><h1>Train with purpose.<br /><em>Grow with confidence.</em></h1><p class="hero-lede">A real neighborhood martial arts school for kids, teens, adults, and curious beginners. Learn useful things, work hard with good people, and keep getting better.</p><div class="hero-actions"><a class="button button--cyan" href={withBase('/contact/')} data-contact-open>Start training <span aria-hidden="true">↗</span></a><a class="button button--ghost" href={withBase('/schedule/')}>See the schedule <span aria-hidden="true">→</span></a></div><div class="hero-details"><span><b>Kids</b> Ages 5–11</span><span><b>Teens & adults</b> Ages 12+</span><span><b>Eskrima</b> Adults 16+</span></div></div><div class="hero-home-photo"><img src={withBase('/images/dojo-class.jpg')} width="1200" height="800" fetchpriority="high" alt="Task Karate students and instructors training together on the mat" /><div class="photo-caption"><span class="caption-mark"></span> Real people. Real practice.</div></div></div></div></section>

  <section class="section v3-intro-section"><div class="shell"><div class="v3-stack"><div class="v3-frame-back" aria-hidden="true"></div><div class="v3-panel v3-copy-panel"><p class="eyebrow">La Crosse • Friendly • Practical</p><h2>One dojo. One teacher.<br /><em>A lifetime of martial arts.</em></h2><p class="large-copy">At Task Karate School, you do not get lost in a crowd. You train directly with people who know you, challenge you, and want you to keep growing.</p><a class="arrow-link arrow-link--light" href={withBase('/about/')}>Meet the school <span aria-hidden="true">→</span></a></div></div></div></section>

  <section class="section programs-showcase"><div class="shell"><SectionIntro eyebrow="Find your way in" title="Different goals.<br /><em>Same good work.</em>" copy="Start with the program that fits your age, interests, and experience. The public schedule shows the current class times and rank groups." light /><div class="program-tabs-shell v3-stack"><div class="v3-frame-back" aria-hidden="true"></div><div class="program-tabs v3-panel"><div class="program-tab-list" role="tablist" aria-label="Task Karate programs"><button class="program-tab is-active" id="home-tab-kids" role="tab" aria-selected="true" aria-controls="home-panel-kids">Kids Karate<span>Core karate · ages 5–11</span></button><button class="program-tab" id="home-tab-adults" role="tab" aria-selected="false" aria-controls="home-panel-adults">Teens & adults<span>Core karate · ages 12+</span></button><button class="program-tab" id="home-tab-eskrima" role="tab" aria-selected="false" aria-controls="home-panel-eskrima">IS3 · Eskrima<span>Filipino martial arts · adults 16+</span></button><button class="program-tab" id="home-tab-sparring" role="tab" aria-selected="false" aria-controls="home-panel-sparring">Sparring<span>Current students · ask about fit</span></button></div><div class="program-tab-panels"><article class="program-tab-panel is-active" id="home-panel-kids" role="tabpanel" aria-labelledby="home-tab-kids"><div class="program-tab-panel-copy"><p class="eyebrow eyebrow--gold">Core karate • Kids</p><h3>Build confidence<br /><em>one class at a time.</em></h3><p>{programs[0].summary}</p><a class="arrow-link arrow-link--light" href={withBase('/programs/kids/')}>Explore Kids Karate <span aria-hidden="true">→</span></a></div><div class="program-tab-panel-media"><img src={programs[0].image} width="1200" height="800" loading="lazy" decoding="async" alt={programs[0].alt} /><span aria-hidden="true">01</span></div></article><article class="program-tab-panel" id="home-panel-adults" role="tabpanel" aria-labelledby="home-tab-adults" hidden><div class="program-tab-panel-copy"><p class="eyebrow eyebrow--gold">Core karate • Teens & adults</p><h3>Train with purpose.<br /><em>Keep getting better.</em></h3><p>{programs[1].summary}</p><a class="arrow-link arrow-link--light" href={withBase('/programs/teens-adults/')}>Explore teens & adults <span aria-hidden="true">→</span></a></div><div class="program-tab-panel-media"><img src={programs[1].image} width="1200" height="800" loading="lazy" decoding="async" alt={programs[1].alt} /><span aria-hidden="true">02</span></div></article><article class="program-tab-panel" id="home-panel-eskrima" role="tabpanel" aria-labelledby="home-tab-eskrima" hidden><div class="program-tab-panel-copy"><p class="eyebrow eyebrow--gold">IS3 • Eskrima</p><h3>Useful movement.<br /><em>Focused practice.</em></h3><p>{programs[2].summary}</p><a class="arrow-link arrow-link--light" href={withBase('/programs/eskrima/')}>Explore IS3 Eskrima <span aria-hidden="true">→</span></a></div><div class="program-tab-panel-media"><img src={programs[2].image} width="1200" height="800" loading="lazy" decoding="async" alt={programs[2].alt} /><span aria-hidden="true">03</span></div></article><article class="program-tab-panel" id="home-panel-sparring" role="tabpanel" aria-labelledby="home-tab-sparring" hidden><div class="program-tab-panel-copy"><p class="eyebrow eyebrow--gold">Current students</p><h3>Live practice.<br /><em>With control.</em></h3><p>{programs[3].summary}</p><a class="arrow-link arrow-link--light" href={withBase('/programs/sparring/')}>Explore Sparring <span aria-hidden="true">→</span></a></div><div class="program-tab-panel-media"><img src={programs[3].image} width="1200" height="800" loading="lazy" decoding="async" alt={programs[3].alt} /><span aria-hidden="true">04</span></div></article></div></div></div></div></section>

  <section class="section section--navy why-section"><GeometricPattern class="geo-pattern--section" /><div class="shell why-grid"><div><p class="eyebrow eyebrow--cyan">The Task difference</p><h2>A small school.<br /><em>A real family.</em></h2></div><div class="why-copy"><p class="large-copy">You get to know the people you train with. Task is serious about practice and relaxed about ego—a place where people learn together, take care of their partners, and keep showing up.</p><a class="arrow-link arrow-link--light" href={withBase('/about/')}>Meet the school <span aria-hidden="true">→</span></a></div></div></section>

  <section class="section section--light instructor-section"><div class="shell instructor-grid v3-stack"><div class="v3-frame-back" aria-hidden="true"></div><div class="instructor-photo v3-panel"><img src={withBase('/images/randy-thomson.png')} width="194" height="298" loading="lazy" alt="Randy Thomson, owner and head instructor of Task Karate" /><span>Owner · Head instructor</span></div><div class="instructor-copy"><p class="eyebrow eyebrow--gold">People make the place</p><h2>Learn from someone<br /><em>who keeps learning.</em></h2><p class="large-copy">Randy “Mr. T” Thomson has spent more than 30 years in martial arts and more than 20 years teaching. He is a U.S. Army veteran and a fourth-degree black belt.</p><p>Read the full school story, meet the assistant instructors, and see how Task’s American Karate practice has grown over time.</p><a class="arrow-link arrow-link--light" href={withBase('/about/')}>Read about Task Karate <span aria-hidden="true">→</span></a></div></div></section>

  <section class="section schedule-home"><div class="shell v3-stack"><div class="v3-frame-back" aria-hidden="true"></div><div class="schedule-home-grid v3-panel"><div><p class="eyebrow eyebrow--gold">The public schedule</p><h2>Know when<br /><em>you can train.</em></h2><p>See class times by program, belt group, and day. Every time pill opens the details that matter.</p><a class="button button--blue" href={withBase('/schedule/')}>View the schedule <span aria-hidden="true">→</span></a></div><div class="schedule-snapshot"><div><span>Kids Karate</span><b>Afternoons · Saturday</b></div><div><span>Teens & adults</span><b>Morning · evening · Saturday</b></div><div><span>IS3 · Eskrima</span><b>Monday · Wednesday · Friday</b></div></div></div></div></section>

  <LocationMap eyebrow="Make the first visit easy" title="Know where<br /><em>you’re going.</em>" copy="Task Karate is a neighborhood school in La Crosse. Check the map, look over the public schedule, and call or email if you have questions before your first class." />

  <section class="section culture-section"><div class="shell culture-grid"><img src={withBase('/images/class-group.jpg')} width="843" height="576" loading="lazy" alt="Task Karate students and instructors gathered together after training" /><div><p class="eyebrow eyebrow--cyan">A neighborhood school</p><h2>Come as you are.<br /><em>Keep moving forward.</em></h2><p>Whether this is your first class or your next chapter in martial arts, there is room to learn at Task Karate.</p><ul class="culture-list"><li><span>01</span> Show up as you are.</li><li><span>02</span> Train with care for your partners.</li><li><span>03</span> Leave with something useful.</li></ul></div></div></section>

  <CtaSection eyebrow="Ready when you are" title="Start with a simple conversation." copy="Tell the school what you are looking for and they can help you find the right place to begin." href="/contact/" label="Start training" />
</BaseLayout>

<script is:inline>
  const tabs = /** @type {HTMLButtonElement[]} */ ([...document.querySelectorAll('.program-tab')]);
  const panels = /** @type {HTMLElement[]} */ ([...document.querySelectorAll('.program-tab-panel')]);
  /** @param {HTMLButtonElement} tab @param {boolean} [moveFocus] */
  const activateTab = (tab, moveFocus = false) => {
    tabs.forEach((item) => {
      const active = item === tab;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', String(active));
      item.setAttribute('tabindex', active ? '0' : '-1');
    });
    panels.forEach((panel) => {
      const active = panel.id === tab.getAttribute('aria-controls');
      panel.classList.toggle('is-active', active);
      panel.toggleAttribute('hidden', !active);
    });
    if (moveFocus) tab.focus();
  };
  tabs.forEach((tab, index) => {
    tab.setAttribute('tabindex', index === 0 ? '0' : '-1');
    tab.addEventListener('click', () => activateTab(tab));
    tab.addEventListener('keydown', /** @param {KeyboardEvent} event */ (event) => {
      if (!['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : event.key === 'ArrowRight' || event.key === 'ArrowDown' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
      activateTab(tabs[next], true);
    });
  });
</script>
