---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GeometricPattern from '@/components/GeometricPattern.astro';
import { programs } from '@/data/programs';
import { scheduleClasses } from '@/data/schedule';
import { withBase } from '@/lib/paths';

export function getStaticPaths() {
  return programs.map((program) => ({
    params: { program: program.id },
    props: { program }
  }));
}

const { program } = Astro.props;
const relatedClasses = scheduleClasses.filter((item) => {
  if (program.id === 'kids') return item.title === 'Kids Karate';
  if (program.id === 'teens-adults') return item.title === 'Teens & Adults';
  if (program.id === 'eskrima') return item.rankLabel === 'Adult Eskrima';
  return item.title === 'Sparring';
});
---
<BaseLayout title={program.title + ' | Task Karate School'} description={program.summary + ' Learn more about ' + program.title + ' at Task Karate School in La Crosse, Wisconsin.'} image={program.image}>
  <section class="page-hero"><GeometricPattern class="geo-pattern--page" /><div class="shell page-hero-grid"><nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBase('/programs/')}>Programs</a><span aria-hidden="true">/</span><span>{program.title}</span></nav><div><p class="eyebrow eyebrow--cyan">{program.label}</p><h1>{program.title}<br /><em>at Task Karate.</em></h1></div><p>{program.detail}</p></div></section>
  <section class="section program-detail-page"><div class="shell program-detail-grid"><div class="program-detail-image v3-stack"><div class="v3-frame-back" aria-hidden="true"></div><div class="v3-panel"><img src={program.image} width="1200" height="800" loading="lazy" decoding="async" alt={program.alt} /></div></div><div class="program-detail-copy"><p class="eyebrow eyebrow--gold">What to expect</p><h2>{program.summary}</h2><p class="large-copy">{program.detail}</p>{program.id === 'kids' && <p>Kids build their practice through attention, coordination, respect, and the confidence that comes from trying again. Parents do not need to know martial arts before they start the conversation.</p>}{program.id === 'teens-adults' && <p>Teens and adults can start with the fundamentals or bring previous experience. The work scales with you: technique, conditioning, partner practice, and steady progress.</p>}{program.id === 'eskrima' && <p>IS3 · Eskrima has its own rhythm and vocabulary. Training emphasizes timing, distance, coordination, and control, with room to ask questions as you learn.</p>}{program.id === 'sparring' && <p>Sparring is for current students who are ready for live practice. Gear, experience, and safety expectations matter; ask your instructor about the right starting point.</p>}<div class="program-detail-actions"><a class="button button--blue" href={'/schedule/?program=' + program.id}>See class times <span aria-hidden="true">→</span></a><a class="arrow-link arrow-link--light" href="/contact/">Ask about fit <span aria-hidden="true">↗</span></a></div></div></div></section>
  <section class="section program-detail-schedule"><div class="shell"><div class="section-intro section-intro--light"><div><p class="eyebrow eyebrow--cyan">Public schedule</p><h2>When this program<br /><em>meets.</em></h2></div><p>These are the published class times connected to this program. Tap the schedule pill for belt group, audience, and duration.</p></div><div class="program-detail-times">{relatedClasses.slice(0, 8).map((item) => <div class="program-detail-time"><span>{item.day}</span><strong>{item.time}</strong><small>{item.rankLabel} · {item.duration}</small></div>)}</div><a class="arrow-link arrow-link--light" href={'/schedule/?program=' + program.id}>Open the full schedule <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
