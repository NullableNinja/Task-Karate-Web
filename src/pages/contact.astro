---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GeometricPattern from '@/components/GeometricPattern.astro';
import LocationMap from '@/components/LocationMap.astro';
import { site } from '@/data/site';
---
<BaseLayout title="Contact Task Karate | Start training in La Crosse" description="Contact Task Karate School in La Crosse, Wisconsin about Kids Karate, teen and adult training, Eskrima, and the public class schedule.">
  <section class="page-hero"><GeometricPattern class="geo-pattern--page" /><div class="shell page-hero-grid"><div><p class="eyebrow eyebrow--cyan">Start training</p><h1>Find the right<br /><em>place to begin.</em></h1></div><p>Tell the school what you are looking for. They can help you find the right program, class, and next step.</p></div></section>
  <section class="section section--light"><div class="shell contact-grid"><div><p class="eyebrow eyebrow--teal">Contact Task Karate</p><h2>A first conversation can be simple.</h2><p class="large-copy">Whether you are looking for kids karate, teen or adult training, or Eskrima, share what you are considering and the school can help you find the right class.</p><div class="contact-options"><a href={`tel:${site.phoneHref}`}><span class="contact-icon">☎</span><span><small>Call the school</small><b>{site.phoneDisplay}</b></span></a><a class="contact-form-jump" href="#contact-form"><span class="contact-icon">↗</span><span><small>Use the contact form</small><b>Send a message from this page</b></span></a></div></div><div class="contact-form-card" id="contact-form"><p class="eyebrow eyebrow--gold">Send a message</p><h2>Let’s start with<br /><em>the basics.</em></h2><p class="contact-form-intro">Share enough for the school to understand what you need. You do not have to know the perfect program name before you reach out.</p><form class="lead-form" action={site.contactFormAction} method="POST"><input type="hidden" name="_subject" value="New Task Karate website inquiry" /><input type="hidden" name="_next" value={site.contactFormNext} /><input type="hidden" name="_template" value="table" /><input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="form-honeypot" /><div class="form-field-grid"><label>Name<input type="text" name="name" autocomplete="name" required /></label><label>Email<input type="email" name="email" autocomplete="email" required /></label></div><div class="form-field-grid"><label>Phone <span>(optional)</span><input type="tel" name="phone" autocomplete="tel" /></label><label>Who is training?<select name="student_type" required><option value="" disabled selected>Select one</option><option>Me</option><option>My child</option><option>My teen</option><option>More than one person</option><option>Not sure yet</option></select></label></div><label>What are you interested in?<select name="program" required><option value="" disabled selected>Select a program</option><option>Kids Karate</option><option>Teens & Adults Karate</option><option>IS3 / Eskrima</option><option>Sparring</option><option>Not sure yet</option></select></label><label>Message<textarea name="message" rows="5" placeholder="Tell us what you are hoping to learn, or ask a question." required></textarea></label><button class="button button--gold" type="submit">Send inquiry <span aria-hidden="true">↗</span></button><p class="form-note">Your message goes to {site.email}. The school will use your contact information only to respond to this inquiry.</p></form><p class="form-success" id="form-success" hidden role="status">Thanks — your message was sent. The school will be in touch.</p></div></div></section>
  <LocationMap eyebrow="Plan the visit" title="Find the dojo<br /><em>in La Crosse.</em>" copy="Use the map for the building location, then open directions in your preferred map app. If you are unsure which class to attend, call or email first." compact />
</BaseLayout>

<script is:inline>
  const formSuccess = /** @type {HTMLElement | null} */ (document.querySelector('#form-success'));
  if (formSuccess && new URLSearchParams(window.location.search).get('sent') === '1') formSuccess.hidden = false;
</script>
